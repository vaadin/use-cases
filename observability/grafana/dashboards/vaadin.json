{
  "title": "Vaadin application",
  "uid": "vaadin-app",
  "schemaVersion": 39,
  "version": 3,
  "editable": true,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "5s",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Active sessions",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(vaadin_sessions_active)"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Active UIs",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(vaadin_ui_active)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Requests handled",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(vaadin_request_duration_seconds_count)"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Errors",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(vaadin_errors_total)"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Request latency percentiles (s)",
      "description": "Percentiles need histogram buckets; see management.metrics.distribution.percentiles-histogram in application.properties.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(vaadin_request_duration_seconds_bucket[$__rate_interval])))"
        },
        {
          "refId": "B",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(vaadin_request_duration_seconds_bucket[$__rate_interval])))"
        },
        {
          "refId": "C",
          "legendFormat": "p99",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(vaadin_request_duration_seconds_bucket[$__rate_interval])))"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "RPC duration by type (s, p95)",
      "description": "Grouped by the rpc type tag. Grouping by component or view is not possible: the kit keeps that attribution off meter tags to bound cardinality (API-GAPS #8).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{type}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, type) (rate(vaadin_rpc_duration_seconds_bucket[$__rate_interval])))"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Navigations per second by route",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{route}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (route) (rate(vaadin_navigation_seconds_count[$__rate_interval]))"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Session lock wait (s, p95)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "wait p95",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(vaadin_session_lock_wait_seconds_bucket[$__rate_interval])))"
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "UI state nodes held",
      "description": "Total server-side UI state across all sessions (kit gauge, opt-in via vaadin.observability.ui-state). For a server-driven app this, not request rate, is what predicts running out of memory.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(vaadin_ui_state_nodes)"
        }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "State nodes per UI (mean)",
      "description": "Per-tab cost. Multiply by expected concurrency to size an instance; a jump here means a heavier view shipped, not more users.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(vaadin_ui_state_nodes) / clamp_min(sum(vaadin_ui_active), 1)"
        }
      ]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Largest single UI",
      "description": "Worst case for one browser tab. The tail exhausts a heap, not the mean.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(vaadin_ui_state_nodes_max)"
        }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Retained view instances",
      "description": "Route targets still held in a tree. Persistently above one per UI means views outlive their navigation \u2014 a leak that scales with users.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(vaadin_ui_state_views)"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Retained UI state vs heap",
      "description": "The scaling decision in one chart: how much of the heap live users' UI state accounts for, and how much ceiling is left. vaadin_ui_state_size_bytes is NaN until vaadin.observability.ui-state-bytes-per-node is set: the kit counts nodes and will not guess what one weighs.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 27
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(vaadin_ui_state_size_bytes)",
          "legendFormat": "retained UI state (measured)"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})",
          "legendFormat": "heap used"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(jvm_memory_max_bytes{area=\"heap\"})",
          "legendFormat": "heap max"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Users vs the state they hold",
      "description": "Counts and size on one axis. When the state line climbs while the session line is flat, capacity is being consumed by what users have open rather than by how many of them there are \u2014 the case a count-only dashboard cannot show.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 27
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(vaadin_sessions_active)",
          "legendFormat": "sessions"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(vaadin_ui_active)",
          "legendFormat": "UIs"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(vaadin_session_uis_max)",
          "legendFormat": "max UIs one session holds"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(vaadin_ui_state_nodes) / 1000",
          "legendFormat": "state nodes (thousands)"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "How current the state reading is",
      "description": "vaadin.ui.state.sample.age.max: a UI is measured on its own session's thread, so an idle user contributes their state as of their last interaction. This is how stale the oldest measurement in the aggregate is \u2014 read the state panels against it rather than assuming they are live.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 36
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(vaadin_ui_state_sample_age_max_seconds)",
          "legendFormat": "stalest measurement"
        }
      ]
    }
  ]
}
